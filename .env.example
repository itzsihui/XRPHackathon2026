OPENAI_API_KEY=

# Firebase (buyer + merchant auth / Firestore — public web config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# XRPL Testnet + RLUSD x402
XRPL_NETWORK=xrpl:1
XRPL_RPC_URL=https://s.altnet.rippletest.net:51234/
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233
XRPL_FACILITATOR_URL=https://xrpl-facilitator-testnet.t54.ai
# Classic r… address that receives RLUSD (merchant payTo)
MERCHANT_ADDRESS=
# Family seed / secret for server-side buyer settle (never commit real seeds)
XRPL_BUYER_SEED=
# Borneo verified-seller issuer (XLS-70 Credentials). Create + fund with:
#   node scripts/borneo-issuer-setup.mjs
# Without it, everything still runs; sellers just show as "unverified".
BORNEO_ISSUER_SEED=
# Optional: issuer address only (read-only deployments that verify but don't issue)
BORNEO_ISSUER_ADDRESS=
TOKEN_SYMBOL=RLUSD
TOKEN_DECIMALS=6
# RLUSD testnet issuer + 40-hex currency (defaults match SingHacks testnet)
# TOKEN_ISSUER=rQhWct2fv4Vc4KRjRgMrxa8xPN9Zx9iLKV
# TOKEN_ADDRESS=524C555344000000000000000000000000000000
EXPLORER_BASE=https://testnet.xrpl.org

# Optional: DynamoDB catalog instead of Firestore (Lambda / AWS)
# AISLE_TABLE=

# Setup notes (preferred: t54 rlusd-cli — https://github.com/t54-labs/rlusd-cli)
#   npm install -g github:t54-labs/rlusd-cli   # NOT @rlusd/cli (unpublished on npm)
#   rlusd config set --network testnet
#   rlusd wallet generate --chain xrpl --name borneo-buyer
#   rlusd faucet fund --chain xrpl
#   rlusd xrpl trustline setup
#   rlusd faucet fund --chain xrpl    # again for RLUSD claim when XRP is funded
#   Put buyer s… secret in XRPL_BUYER_SEED and merchant r… in MERCHANT_ADDRESS
# Full walkthrough: scripts/setup-xrpl-rlusd.md
