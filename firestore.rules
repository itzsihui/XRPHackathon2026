rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Buyer profiles (shop / pay / governance)
    match /buyers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Merchant profiles (wallet, Mastercard, storeSlugs, onboarding draft)
    match /merchants/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Marketplace catalog — public read so /api/market and agents can list SKUs.
    // Authenticated merchants may publish/update their own store documents.
    match /stores/{slug} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}
